    <section class="cs-panel mt-4">
        <h2>Historial de acciones</h2>
        <ul class="list-unstyled small mb-0">
            <c:forEach var="h" items="${historial}">
                <li class="py-1 border-bottom">
                    <span class="cs-mono"><c:out value="${h.fechaAccionFormateada}"/></span>
                    · <strong><c:out value="${h.nombreUsuario}"/></strong>
                    · <c:out value="${h.accion}"/>
                    <c:if test="${not empty h.detalle}">— <c:out value="${h.detalle}"/></c:if>
                </li>
            </c:forEach>
        </ul>
        <c:if test="${empty historial}">
            <p class="small text-muted mb-0">Sin acciones registradas.</p>
        </c:if>
        <nav class="d-flex gap-3 mt-3" aria-label="Páginas del historial">
            <c:if test="${not empty param.antes}"><a href="${ctx}/admin/usuarios">Más recientes</a></c:if>
            <c:if test="${not empty siguiente}"><a href="${ctx}/admin/usuarios?antes=${siguiente}">Ver acciones anteriores</a></c:if>
        </nav>
    </section>
