<aside class="cs-admin-sidebar" aria-label="Menú de administración">
    <div class="cs-admin-brand-block">
        <a class="cs-admin-brand" href="${ctx}/admin/pedidos" aria-label="CHERO.SAC, inicio de administración">
            <span class="cs-admin-brand-mark">C</span>
            <span>CHERO<span class="cs-admin-brand-accent">.SAC</span></span>
        </a>
        <span class="cs-admin-brand-caption">TECNOLOGÍA Y HARDWARE</span>
    </div>

    <div class="cs-admin-profile">
        <div class="cs-admin-avatar">CH</div>
        <div class="cs-admin-profile-copy">
            <strong><c:out value="${sessionScope.usuarioAdmin.nombreCompleto}"/></strong>
            <span><c:choose><c:when test="${sessionScope.usuarioAdmin.rol == 'DUENO'}">Propietario de la tienda</c:when><c:otherwise>Personal de administración</c:otherwise></c:choose></span>
            <small><i></i> Sesión activa</small>
        </div>
    </div>

    <div class="cs-admin-nav-caption">GESTIÓN DE LA TIENDA</div>
    <nav class="cs-admin-nav" aria-label="Navegación principal">
        <a class="cs-admin-nav-link" href="${ctx}/admin/pedidos"><span class="cs-admin-nav-icon">⌂</span><span>Panel principal</span></a>
        <a class="cs-admin-nav-link" href="${ctx}/admin/pedidos"><span class="cs-admin-nav-icon">▤</span><span>Pedidos</span><c:if test="${pedidosPendientes gt 0}"><b class="cs-admin-nav-count"><c:out value="${pedidosPendientes}"/></b></c:if></a>
        <a class="cs-admin-nav-link" href="${ctx}/admin/inventario"><span class="cs-admin-nav-icon">▦</span><span>Productos e inventario</span></a>
        <a class="cs-admin-nav-link" href="${ctx}/admin/devoluciones"><span class="cs-admin-nav-icon">↻</span><span>Postventa y garantías</span></a>
        <c:if test="${sessionScope.usuarioAdmin.rol == 'DUENO'}">
            <div class="cs-admin-nav-caption cs-admin-nav-caption-space">ANÁLISIS Y PERSONAL</div>
            <a class="cs-admin-nav-link" href="${ctx}/admin/reportes"><span class="cs-admin-nav-icon">▥</span><span>Reportes de ventas</span></a>
            <a class="cs-admin-nav-link" href="${ctx}/admin/usuarios"><span class="cs-admin-nav-icon">♙</span><span>Trabajadores y auditoría</span></a>
        </c:if>
    </nav>

    <div class="cs-admin-sidebar-bottom">
        <a class="cs-admin-store-link" href="${ctx}/catalogo"><span>↗</span> Ver tienda pública</a>
        <form method="post" action="${ctx}/logout">
            <input type="hidden" name="csrf" value="${sessionScope.csrf}">
            <button class="cs-admin-logout" type="submit"><span>⇥</span> Cerrar sesión</button>
        </form>
        <small>CHERO.SAC · PANEL PRIVADO</small>
    </div>
</aside>
