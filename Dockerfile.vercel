# CHERO.SAC - despliegue en Vercel Container Runtime
# Compila la aplicación WAR con Java 17 y la ejecuta en Tomcat 10.1.
FROM maven:3.9.16-eclipse-temurin-17 AS build
WORKDIR /workspace
COPY pom.xml ./pom.xml
COPY src ./src
RUN mvn -B -DskipTests clean package

FROM tomcat:10.1.62-jre17-temurin
ENV CATALINA_HOME=/usr/local/tomcat
WORKDIR /usr/local/tomcat

# Publica CHERO.SAC en la raíz del dominio de Vercel.
RUN rm -rf /usr/local/tomcat/webapps/*
COPY --from=build /workspace/target/CheroSacWeb.war /usr/local/tomcat/webapps/ROOT.war
COPY deploy/start-tomcat-vercel.sh /usr/local/bin/start-tomcat-vercel.sh
RUN chmod 0755 /usr/local/bin/start-tomcat-vercel.sh

# Vercel se configurará con PORT=8080; el script ajusta el Connector de Tomcat.
EXPOSE 8080
CMD ["/usr/local/bin/start-tomcat-vercel.sh"]
